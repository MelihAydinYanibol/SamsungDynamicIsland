<?xml version="1.0" encoding="utf-8"?>
<!-- Children of IslandView, which measures and positions them itself. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <!-- Compact pill: content sits on either side of the camera. -->
    <LinearLayout
        android:id="@+id/compact"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/compact_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/cd_app_icon"
            android:scaleType="centerCrop" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/compact_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/island_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/compact_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/island_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <io.github.melihaydinyanibol.dynamicisland.ui.EqualizerView
                android:id="@+id/compact_eq"
                android:layout_width="22dp"
                android:layout_height="18dp" />

            <io.github.melihaydinyanibol.dynamicisland.ui.ProgressRingView
                android:id="@+id/compact_ring"
                android:layout_width="20dp"
                android:layout_height="20dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Expanded card. -->
    <LinearLayout
        android:id="@+id/expanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <!-- Header row shares the line with the camera hole. -->
        <LinearLayout
            android:id="@+id/exp_header"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/exp_app_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/cd_app_icon" />

            <TextView
                android:id="@+id/exp_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/island_text_secondary"
                android:textSize="13sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Chronometer
                android:id="@+id/exp_chrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/island_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <io.github.melihaydinyanibol.dynamicisland.ui.EqualizerView
                android:id="@+id/exp_eq"
                android:layout_width="24dp"
                android:layout_height="20dp" />

            <TextView
                android:id="@+id/exp_trailing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/island_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/exp_image"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_rounded_image"
                android:contentDescription="@string/cd_artwork"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exp_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/island_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/exp_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="@color/island_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/exp_progress"
            style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:id="@+id/exp_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/exp_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/island_text_secondary"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/exp_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/exp_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/island_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/exp_prev"
                    style="@style/MediaButton"
                    android:contentDescription="@string/cd_previous"
                    android:src="@drawable/ic_skip_previous" />

                <ImageButton
                    android:id="@+id/exp_play"
                    style="@style/MediaButton"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@string/cd_play_pause"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/exp_next"
                    style="@style/MediaButton"
                    android:contentDescription="@string/cd_next"
                    android:src="@drawable/ic_skip_next" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/exp_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />
    </LinearLayout>
</merge>
