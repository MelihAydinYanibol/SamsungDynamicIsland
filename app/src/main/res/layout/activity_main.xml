<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="56dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/device_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_permissions" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_accessibility"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/perm_accessibility_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/perm_accessibility_button"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_open"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_notifications"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/perm_notifications_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/perm_notifications_button"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_open"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perm_battery"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/perm_battery_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/perm_battery_button"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_open"
                    android:textColor="@color/accent" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_features" />

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/switch_enabled"
                style="@style/SwitchRow"
                android:text="@string/pref_enabled" />

            <Switch
                android:id="@+id/switch_show_idle"
                style="@style/SwitchRow"
                android:text="@string/pref_show_idle" />

            <Switch
                android:id="@+id/switch_notifications"
                style="@style/SwitchRow"
                android:text="@string/pref_notifications" />

            <Switch
                android:id="@+id/switch_media"
                style="@style/SwitchRow"
                android:text="@string/pref_media" />

            <Switch
                android:id="@+id/switch_live"
                style="@style/SwitchRow"
                android:text="@string/pref_live" />

            <Switch
                android:id="@+id/switch_charging"
                style="@style/SwitchRow"
                android:text="@string/pref_charging" />

            <Switch
                android:id="@+id/switch_ringer"
                style="@style/SwitchRow"
                android:text="@string/pref_ringer" />

            <Switch
                android:id="@+id/switch_hide_landscape"
                style="@style/SwitchRow"
                android:text="@string/pref_hide_landscape" />

            <Switch
                android:id="@+id/switch_haptics"
                style="@style/SwitchRow"
                android:text="@string/pref_haptics" />

        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_layout" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/pref_offset_x" />

                    <TextView
                        android:id="@+id/offset_x_value"
                        style="@style/RowValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/offset_x_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/pref_offset_y" />

                    <TextView
                        android:id="@+id/offset_y_value"
                        style="@style/RowValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/offset_y_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/pref_scale" />

                    <TextView
                        android:id="@+id/scale_value"
                        style="@style/RowValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/scale_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RowLabel"
                        android:text="@string/pref_alert_seconds" />

                    <TextView
                        android:id="@+id/alert_seconds_value"
                        style="@style/RowValue" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/alert_seconds_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_try" />

        <LinearLayout style="@style/Card">

            <LinearLayout
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/test_notification"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/test_notification"
                    android:textColor="@color/accent" />

                <Button
                    android:id="@+id/test_charging"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/test_charging"
                    android:textColor="@color/accent" />

            </LinearLayout>

            <LinearLayout
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/test_timer"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/test_timer"
                    android:textColor="@color/accent" />

                <Button
                    android:id="@+id/test_stop"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/test_stop"
                    android:textColor="@color/accent" />

            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_tips" />

        <TextView
            style="@style/Card"
            android:lineSpacingMultiplier="1.25"
            android:padding="16dp"
            android:text="@string/tips_body"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/version_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
